# === Validator (Web UI) ===
VALIDATOR_URL=https://validator-v2.eltex.loc
VALIDATOR_USER=admin
VALIDATOR_PASSWORD=admin

# === SSH (Ansible) ===
ANSIBLE_USER=admin
ANSIBLE_PASSWORD=admin
TFTP_SERVER_IP=192.168.246.95

# === Paths ===
DOWNLOAD_DIR=~/work_pc
ANSIBLE_INVENTORY=inventory.yml
ANSIBLE_PLAYBOOK=upgrade.yml

# === Timeouts & Delays (seconds) ===
RETRY_DELAY=2
POLL_INTERVAL=30
POLL_GRANULARITY=1
POST_UPGRADE_DELAY=2
ANSIBLE_COMMAND_TIMEOUT=600

# === Download ===
DOWNLOAD_CHUNK_SIZE=8192

# === SSL ===
VERIFY_SSL=false
